# Copy this file to .env on the server before running docker compose.

TRAEFIK_ACME_EMAIL=admin@example.com
SPMI_FRONTEND_DOMAIN=spmi.example.com
SPMI_API_DOMAIN=api.spmi.example.com

POSTGRES_DB=spmi_command_center
POSTGRES_USER=spmi
POSTGRES_PASSWORD=change-this-database-password

# Minimum 32 characters in production.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

ENABLE_API_DOCS=false
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_MAX=120

SIAKAD_SYNC_ENABLED=false
SIAKAD_BASE_URL=
SIAKAD_AUTH_TYPE=bearer
SIAKAD_API_TOKEN=
SIAKAD_ORG_UNITS_PATH=/org-units
SIAKAD_TIMEOUT_MS=10000
SIAKAD_SYNC_MODE=manual

# UAT note:
# With real SIAKAD, run preview first using UAT_START_MOCK_SIAKAD=false.
# Add UAT_ALLOW_COMMIT=true only after the preview is approved.
