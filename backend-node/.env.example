PORT=4000
NODE_ENV=development
APP_MODE=local_mock
APP_URL=http://localhost:4000
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=1d
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_MAX=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spmi_command_center?schema=public
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3002,https://spmi.universitasjunrejoindah.ac.id
ENABLE_API_DOCS=false

SIAKAD_SYNC_ENABLED=false
SIAKAD_BASE_URL=https://siakad.example.ac.id/api
SIAKAD_AUTH_TYPE=bearer
SIAKAD_API_TOKEN=
SIAKAD_ORG_UNITS_PATH=/org-units
SIAKAD_TIMEOUT_MS=10000
SIAKAD_SYNC_MODE=manual
