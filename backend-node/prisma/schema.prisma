generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin_lpm
  auditor
  dekan
  wakil_dekan
  kaprodi
  sekprodi
  unit_kerja
  guest
}

enum StandardStatus {
  aktif
  nonaktif
}

enum PpeppPhase {
  P1
  P2
  E
  P3
  P4
}

enum LifecycleStatus {
  draft
  berjalan
  selesai
  ditutup
}

enum AuditStatus {
  draft
  terjadwal
  berjalan
  selesai
}

enum FindingSeverity {
  rendah
  sedang
  tinggi
  kritis
}

enum SurveyStatus {
  draft
  aktif
  ditutup
}

enum IntegrationStatus {
  online
  offline
  sync_in_progress
  synced
  failed
}

enum ImportType {
  standar
  dokumen
}

enum ApprovalAction {
  submit
  approve
  reject
  revise
}

model User {
  id             String               @id @default(cuid())
  institutionId  String
  name           String
  email          String               @unique
  passwordHash   String
  role           Role                 @default(guest)
  isActive       Boolean              @default(true)
  orgUnitId      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  institution    Institution          @relation(fields: [institutionId], references: [id])
  orgUnit        OrgUnit?             @relation(fields: [orgUnitId], references: [id])
  uploadedDocs   SpmiDocument[]
  ppeppEntries   PpeppCycle[]         @relation("PpeppAuthor")
  auditsAsAuditor AmiAudit[]          @relation("AuditAuditor")
  surveys        Survey[]
  imports        ImportJob[]
  syncLogs       IntegrationSyncLog[]
  roleAssignments UserRole[]
}

model Institution {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  systemName    String
  academicYear  String
  configuration Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  orgUnits      OrgUnit[]
  standards     MutuStandard[]
  settings      SystemSetting[]
}

model OrgUnit {
  id            String       @id @default(cuid())
  institutionId String
  parentId      String?
  name          String
  code          String
  type          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  institution   Institution  @relation(fields: [institutionId], references: [id])
  parent        OrgUnit?     @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children      OrgUnit[]    @relation("OrgUnitHierarchy")
  users         User[]
  ppeppCycles   PpeppCycle[]
  audits        AmiAudit[]   @relation("AuditAuditee")
  documents     SpmiDocument[]
  scopedRoles   UserRole[]    @relation("UserRoleScope")

  @@unique([institutionId, code])
}

model UserRole {
  id             String    @id @default(cuid())
  userId         String
  role           Role
  scopeOrgUnitId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
  scopeOrgUnit   OrgUnit?  @relation("UserRoleScope", fields: [scopeOrgUnitId], references: [id])

  @@unique([userId, role, scopeOrgUnitId])
}

model MutuStandard {
  id            String          @id @default(cuid())
  institutionId String
  code          String?
  title         String
  description   String?
  category      String
  status        StandardStatus  @default(aktif)
  version       String          @default("1.0")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  institution   Institution     @relation(fields: [institutionId], references: [id])
  documents     SpmiDocument[]
  ppeppCycles   PpeppCycle[]
  revisions     MutuStandardRevision[]

  @@unique([institutionId, code])
  @@index([institutionId, category, status])
}

model SpmiDocument {
  id           String        @id @default(cuid())
  title        String
  description  String?
  fileName     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  standardId   String?
  orgUnitId    String?
  uploadedById String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  standard     MutuStandard? @relation(fields: [standardId], references: [id])
  orgUnit      OrgUnit?      @relation(fields: [orgUnitId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  versions     DocumentVersion[]

  @@index([orgUnitId, standardId])
}

model MutuStandardRevision {
  id          String       @id @default(cuid())
  standardId  String
  version     String
  action      String
  snapshot    Json
  note        String?
  actorId     String?
  createdAt   DateTime     @default(now())
  standard    MutuStandard @relation(fields: [standardId], references: [id])

  @@index([standardId, createdAt])
}

model DocumentVersion {
  id          String       @id @default(cuid())
  documentId  String
  version     Int
  fileName    String
  storedName  String
  mimeType    String
  sizeBytes   Int
  checksum    String?
  notes       String?
  uploadedById String?
  createdAt   DateTime    @default(now())
  document    SpmiDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@index([checksum])
}

model PpeppCycle {
  id          String          @id @default(cuid())
  standardId  String
  orgUnitId   String
  phase       PpeppPhase
  content     String
  status      LifecycleStatus @default(draft)
  year        Int
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  standard    MutuStandard    @relation(fields: [standardId], references: [id])
  orgUnit     OrgUnit         @relation(fields: [orgUnitId], references: [id])
  createdBy   User?           @relation("PpeppAuthor", fields: [createdById], references: [id])
}

model AmiAudit {
  id             String        @id @default(cuid())
  title          String
  scheduledDate  DateTime
  auditorId      String
  auditeeUnitId  String
  status         AuditStatus   @default(terjadwal)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  auditor        User          @relation("AuditAuditor", fields: [auditorId], references: [id])
  auditeeUnit    OrgUnit       @relation("AuditAuditee", fields: [auditeeUnitId], references: [id])
  findings       AmiFinding[]
}

model AmiFinding {
  id          String           @id @default(cuid())
  auditId     String
  title       String
  description String
  severity    FindingSeverity
  category    String
  rtlPlan     String?
  rtlStatus   LifecycleStatus  @default(draft)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  audit       AmiAudit         @relation(fields: [auditId], references: [id])
}

model RtmMeeting {
  id              String           @id @default(cuid())
  date            DateTime
  participants    Json
  agenda          String
  decisionResults String
  status          LifecycleStatus  @default(berjalan)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
}

model Survey {
  id          String        @id @default(cuid())
  title       String
  description String?
  questions   Json
  status      SurveyStatus  @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  createdBy   User          @relation(fields: [createdById], references: [id])
  responses   SurveyResponse[]
}

model SurveyResponse {
  id             String    @id @default(cuid())
  surveyId       String
  respondentName String?
  respondentEmail String?
  answers        Json
  createdAt      DateTime  @default(now())
  survey         Survey    @relation(fields: [surveyId], references: [id])
}

model ImportJob {
  id           String      @id @default(cuid())
  type         ImportType
  fileName     String
  storedName   String
  status       LifecycleStatus @default(selesai)
  summary      Json?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  createdBy    User        @relation(fields: [createdById], references: [id])
}

model IntegrationSyncLog {
  id           String            @id @default(cuid())
  service      String
  status       IntegrationStatus
  message      String?
  metadata     Json?
  createdById  String?
  syncedAt     DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User?             @relation(fields: [createdById], references: [id])
}

model SystemSetting {
  id              String    @id @default(cuid())
  institutionId   String
  institutionName String
  academicYear    String
  systemName      String
  configuration   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  institution     Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId])
}

model TokenBlacklist {
  id         String   @id @default(cuid())
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  role        String?
  action      String
  entity      String?
  entityId    String?
  method      String?
  path        String?
  statusCode  Int?
  ipAddress   String?
  userAgent   String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model ApprovalWorkflow {
  id            String   @id @default(cuid())
  institutionId String
  entity        String
  step          String
  ownerRoles    Json
  nextStep      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([institutionId, entity, step])
}

model ApprovalHistory {
  id          String         @id @default(cuid())
  entity      String
  entityId    String
  step        String
  action      ApprovalAction
  actorId     String?
  actorEmail  String?
  note        String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([entity, entityId, createdAt])
}
