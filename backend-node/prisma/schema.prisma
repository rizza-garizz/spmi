generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  lpm
  admin_lpm
  auditor
  dekan
  wakil_dekan
  kaprodi
  sekprodi
  unit_kerja
  operator
  guest
}

enum StandardStatus {
  aktif
  nonaktif
}

enum PpeppPhase {
  P1
  P2
  E
  P3
  P4
}

enum LifecycleStatus {
  draft
  berjalan
  selesai
  ditutup
}

enum AccreditationStatus {
  draft
  berjalan
  review
  final
  selesai
}

enum AccreditationScopeType {
  APT
  APS
}

enum AuditStatus {
  draft
  terjadwal
  berjalan
  selesai
}

enum FindingSeverity {
  rendah
  sedang
  tinggi
  kritis
}

enum SurveyStatus {
  draft
  aktif
  ditutup
}

enum IntegrationStatus {
  online
  offline
  sync_in_progress
  synced
  failed
}

enum ImportType {
  standar
  dokumen
}

enum ApprovalAction {
  submit
  approve
  reject
  revise
}

model User {
  id             String               @id @default(cuid())
  institutionId  String
  name           String
  email          String               @unique
  passwordHash   String
  role           Role                 @default(guest)
  isActive       Boolean              @default(true)
  orgUnitId      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  institution    Institution          @relation(fields: [institutionId], references: [id])
  orgUnit        OrgUnit?             @relation(fields: [orgUnitId], references: [id])
  uploadedDocs   SpmiDocument[]
  ppeppEntries   PpeppCycle[]         @relation("PpeppAuthor")
  auditsAsAuditor AmiAudit[]          @relation("AuditAuditor")
  surveys        Survey[]
  imports        ImportJob[]
  syncLogs       IntegrationSyncLog[]
  roleAssignments UserRole[]
  accreditationPeriods AccreditationPeriod[] @relation("AccreditationCreatedBy")
  accreditationTeamMembers AccreditationTeamMember[]
}

model Institution {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  systemName    String
  academicYear  String
  configuration Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  orgUnits      OrgUnit[]
  standards     MutuStandard[]
  settings      SystemSetting[]
  accreditationInstruments AccreditationInstrument[]
  accreditationPeriods AccreditationPeriod[]
}

model OrgUnit {
  id            String       @id @default(cuid())
  institutionId String
  parentId      String?
  name          String
  code          String
  siakadCode    String?
  type          String
  source        String       @default("manual")
  syncStatus    String       @default("manual")
  lastSyncedAt  DateTime?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  institution   Institution  @relation(fields: [institutionId], references: [id])
  parent        OrgUnit?     @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children      OrgUnit[]    @relation("OrgUnitHierarchy")
  users         User[]
  ppeppCycles   PpeppCycle[]
  audits        AmiAudit[]   @relation("AuditAuditee")
  documents     SpmiDocument[]
  scopedRoles   UserRole[]    @relation("UserRoleScope")
  accreditationPeriods AccreditationPeriod[]
  accreditationAssessments AccreditationAssessment[]

  @@unique([institutionId, code])
  @@index([institutionId, siakadCode])
  @@index([institutionId, source, syncStatus])
}

model UserRole {
  id             String    @id @default(cuid())
  userId         String
  role           Role
  scopeOrgUnitId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
  scopeOrgUnit   OrgUnit?  @relation("UserRoleScope", fields: [scopeOrgUnitId], references: [id])

  @@unique([userId, role, scopeOrgUnitId])
}

model MutuStandard {
  id            String          @id @default(cuid())
  institutionId String
  code          String?
  title         String
  description   String?
  category      String
  status        StandardStatus  @default(aktif)
  version       String          @default("1.0")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  institution   Institution     @relation(fields: [institutionId], references: [id])
  documents     SpmiDocument[]
  ppeppCycles   PpeppCycle[]
  revisions     MutuStandardRevision[]

  @@unique([institutionId, code])
  @@index([institutionId, category, status])
}

model SpmiDocument {
  id           String        @id @default(cuid())
  title        String
  description  String?
  fileName     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  standardId   String?
  orgUnitId    String?
  uploadedById String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  standard     MutuStandard? @relation(fields: [standardId], references: [id])
  orgUnit      OrgUnit?      @relation(fields: [orgUnitId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  versions     DocumentVersion[]

  @@index([orgUnitId, standardId])
}

model MutuStandardRevision {
  id          String       @id @default(cuid())
  standardId  String
  version     String
  action      String
  snapshot    Json
  note        String?
  actorId     String?
  createdAt   DateTime     @default(now())
  standard    MutuStandard @relation(fields: [standardId], references: [id])

  @@index([standardId, createdAt])
}

model DocumentVersion {
  id          String       @id @default(cuid())
  documentId  String
  version     Int
  fileName    String
  storedName  String
  mimeType    String
  sizeBytes   Int
  checksum    String?
  notes       String?
  uploadedById String?
  createdAt   DateTime    @default(now())
  document    SpmiDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@index([checksum])
}

model PpeppCycle {
  id          String          @id @default(cuid())
  standardId  String
  orgUnitId   String
  phase       PpeppPhase
  content     String
  status      LifecycleStatus @default(draft)
  year        Int
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  standard    MutuStandard    @relation(fields: [standardId], references: [id])
  orgUnit     OrgUnit         @relation(fields: [orgUnitId], references: [id])
  createdBy   User?           @relation("PpeppAuthor", fields: [createdById], references: [id])
}

model AmiAudit {
  id             String        @id @default(cuid())
  title          String
  scheduledDate  DateTime
  auditorId      String
  auditeeUnitId  String
  status         AuditStatus   @default(terjadwal)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  auditor        User          @relation("AuditAuditor", fields: [auditorId], references: [id])
  auditeeUnit    OrgUnit       @relation("AuditAuditee", fields: [auditeeUnitId], references: [id])
  findings       AmiFinding[]
}

model AmiFinding {
  id          String           @id @default(cuid())
  auditId     String
  title       String
  description String
  severity    FindingSeverity
  category    String
  rtlPlan     String?
  rtlStatus   LifecycleStatus  @default(draft)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  audit       AmiAudit         @relation(fields: [auditId], references: [id])
}

model RtmMeeting {
  id              String           @id @default(cuid())
  date            DateTime
  participants    Json
  agenda          String
  decisionResults String
  status          LifecycleStatus  @default(berjalan)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
}

model Survey {
  id          String        @id @default(cuid())
  title       String
  description String?
  questions   Json
  status      SurveyStatus  @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  createdBy   User          @relation(fields: [createdById], references: [id])
  responses   SurveyResponse[]
}

model SurveyResponse {
  id             String    @id @default(cuid())
  surveyId       String
  respondentName String?
  respondentEmail String?
  answers        Json
  createdAt      DateTime  @default(now())
  survey         Survey    @relation(fields: [surveyId], references: [id])
}

model ImportJob {
  id           String      @id @default(cuid())
  type         ImportType
  fileName     String
  storedName   String
  status       LifecycleStatus @default(selesai)
  summary      Json?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  createdBy    User        @relation(fields: [createdById], references: [id])
}

model IntegrationSyncLog {
  id           String            @id @default(cuid())
  service      String
  status       IntegrationStatus
  message      String?
  metadata     Json?
  createdById  String?
  syncedAt     DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User?             @relation(fields: [createdById], references: [id])
}

model SiakadSyncBatch {
  id             String                 @id @default(cuid())
  service        String                 @default("siakad")
  entity         String
  source         String
  status         String                 @default("preview")
  summary        Json?
  conflictCount  Int                    @default(0)
  createdByEmail String?
  committedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  orgUnitRows    SiakadOrgUnitStaging[]

  @@index([service, entity, createdAt])
  @@index([status, createdAt])
}

model SiakadOrgUnitStaging {
  id            String          @id @default(cuid())
  batchId       String
  code          String
  siakadCode    String?
  name          String
  type          String
  parentCode    String?
  action        String
  status        String          @default("ready")
  conflictType  String?
  conflictNote  String?
  incoming      Json
  current       Json?
  createdAt     DateTime        @default(now())
  batch         SiakadSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([code])
  @@index([status, conflictType])
}

model AccreditationInstrument {
  id            String                   @id @default(cuid())
  institutionId String
  code          String
  name          String
  agency        String
  level         String
  status        String                   @default("aktif")
  criteriaCount Int                      @default(0)
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?
  institution   Institution              @relation(fields: [institutionId], references: [id])
  criteria      AccreditationCriterion[]
  periods       AccreditationPeriod[]

  @@unique([institutionId, code])
  @@index([institutionId, agency, status])
}

model AccreditationCriterion {
  id               String                  @id @default(cuid())
  instrumentId     String
  code             String
  title            String
  description      String?
  weight           Float                   @default(0)
  evidenceRequired Int                     @default(0)
  standardCodes    Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  instrument       AccreditationInstrument @relation(fields: [instrumentId], references: [id])
  evidence         AccreditationEvidence[]
  scores           AccreditationSelfScore[]
  lkpsSections     AccreditationLkpsSection[]
  ledSections      AccreditationLedSection[]

  @@unique([instrumentId, code])
  @@index([instrumentId])
}

model AccreditationPeriod {
  id             String                    @id @default(cuid())
  institutionId  String
  instrumentId   String
  orgUnitId      String?
  createdById    String?
  name           String
  scopeType      AccreditationScopeType
  agency         String
  startDate      DateTime
  dueDate        DateTime?
  status         AccreditationStatus       @default(draft)
  progress       Int                       @default(0)
  metadata       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  institution    Institution               @relation(fields: [institutionId], references: [id])
  instrument     AccreditationInstrument   @relation(fields: [instrumentId], references: [id])
  orgUnit        OrgUnit?                  @relation(fields: [orgUnitId], references: [id])
  createdBy      User?                     @relation("AccreditationCreatedBy", fields: [createdById], references: [id])
  assessments    AccreditationAssessment[]
  teamMembers    AccreditationTeamMember[]
  tasks          AccreditationTask[]
  milestones     AccreditationMilestone[]
  evidence       AccreditationEvidence[]
  lkpsEntries    AccreditationLkpsEntry[]
  ledContents    AccreditationLedContent[]
  selfScores     AccreditationSelfScore[]
  reviews        AccreditationReview[]
  exports        AccreditationExport[]

  @@index([institutionId, status, dueDate])
  @@index([orgUnitId, status])
}

model AccreditationAssessment {
  id                  String              @id @default(cuid())
  periodId            String
  orgUnitId           String?
  lkpsProgress        Int                 @default(0)
  ledProgress         Int                 @default(0)
  evidenceProgress    Int                 @default(0)
  reviewProgress      Int                 @default(0)
  readinessStatus     String              @default("risk")
  scoreProjection     Float               @default(0)
  predicateProjection String?
  riskLevel           String              @default("merah")
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  period              AccreditationPeriod @relation(fields: [periodId], references: [id])
  orgUnit             OrgUnit?            @relation(fields: [orgUnitId], references: [id])

  @@index([periodId])
  @@index([orgUnitId, readinessStatus])
}

model AccreditationTeamMember {
  id             String              @id @default(cuid())
  periodId       String
  userId         String?
  name           String
  role           String
  responsibility String?
  email          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  period         AccreditationPeriod @relation(fields: [periodId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@unique([periodId, email])
  @@index([periodId, role])
}

model AccreditationTask {
  id        String              @id @default(cuid())
  periodId  String
  title     String
  category  String              @default("UMUM")
  assignee  String?
  priority  String              @default("medium")
  status    String              @default("todo")
  dueDate   DateTime?
  progress  Int                 @default(0)
  notes     String?
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  period    AccreditationPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, status])
  @@index([assignee, dueDate])
  @@index([category, priority])
}

model AccreditationMilestone {
  id        String              @id @default(cuid())
  periodId  String
  title     String
  phase     String              @default("persiapan")
  owner     String?
  startDate DateTime?
  dueDate   DateTime?
  status    String              @default("planned")
  progress  Int                 @default(0)
  notes     String?
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  period    AccreditationPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, status])
  @@index([phase, dueDate])
  @@index([owner, dueDate])
}

model AccreditationEvidence {
  id            String                  @id @default(cuid())
  periodId      String
  criterionId   String?
  lkpsEntryId   String?
  ledContentId  String?
  title         String
  sourceModule  String?
  documentId    String?
  fileName      String?
  fileUrl       String?
  notes         String?
  status        String                  @default("draft")
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?
  period        AccreditationPeriod     @relation(fields: [periodId], references: [id])
  criterion     AccreditationCriterion? @relation(fields: [criterionId], references: [id])

  @@index([periodId, status])
  @@index([criterionId])
  @@index([lkpsEntryId])
  @@index([ledContentId])
}

model AccreditationLkpsSection {
  id             String                 @id @default(cuid())
  criterionId    String?
  code           String
  title          String
  sourceModule   String?
  requiredFields Json?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  criterion      AccreditationCriterion? @relation(fields: [criterionId], references: [id])
  entries        AccreditationLkpsEntry[]

  @@unique([code])
  @@index([criterionId])
}

model AccreditationLkpsEntry {
  id           String                   @id @default(cuid())
  periodId     String
  sectionId    String
  label        String
  value        Float                    @default(0)
  unit         String?
  status       String                   @default("draft")
  sourceModule String?
  notes        String?
  metadata     Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  period       AccreditationPeriod      @relation(fields: [periodId], references: [id])
  section      AccreditationLkpsSection @relation(fields: [sectionId], references: [id])

  @@unique([periodId, sectionId, label])
  @@index([periodId, status])
  @@index([sectionId])
}

model AccreditationLedSection {
  id          String                  @id @default(cuid())
  criterionId String?
  title       String
  guidance    String?
  metadata    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?
  criterion   AccreditationCriterion? @relation(fields: [criterionId], references: [id])
  contents    AccreditationLedContent[]

  @@index([criterionId])
}

model AccreditationLedContent {
  id           String                  @id @default(cuid())
  periodId     String
  sectionId    String
  version      Int                     @default(1)
  content      String
  status       String                  @default("draft")
  reviewerNote String?
  updatedBy    String?
  metadata     Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?
  period       AccreditationPeriod     @relation(fields: [periodId], references: [id])
  section      AccreditationLedSection @relation(fields: [sectionId], references: [id])

  @@index([periodId, sectionId, version])
  @@index([status])
}

model AccreditationSelfScore {
  id             String                 @id @default(cuid())
  periodId       String
  criterionId    String
  score          Float
  targetScore    Float                  @default(4)
  status         String                 @default("draft")
  gapNote        String?
  recommendation String?
  reviewer       String?
  note           String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  period         AccreditationPeriod    @relation(fields: [periodId], references: [id])
  criterion      AccreditationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([periodId, criterionId])
  @@index([criterionId])
  @@index([status])
}

model AccreditationReview {
  id         String              @id @default(cuid())
  periodId   String
  entityType String?
  entityId   String?
  reviewer   String
  status     String              @default("draft")
  decision   String?
  note       String?
  dueDate    DateTime?
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?
  period     AccreditationPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, status])
  @@index([entityType, entityId])
}

model AccreditationExport {
  id        String              @id @default(cuid())
  periodId  String
  type      String
  fileName  String
  status    String              @default("generated")
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  period    AccreditationPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, type, createdAt])
}

model SystemSetting {
  id              String    @id @default(cuid())
  institutionId   String
  institutionName String
  academicYear    String
  systemName      String
  configuration   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  institution     Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId])
}

model TokenBlacklist {
  id         String   @id @default(cuid())
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  role        String?
  action      String
  entity      String?
  entityId    String?
  method      String?
  path        String?
  statusCode  Int?
  ipAddress   String?
  userAgent   String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model ApprovalWorkflow {
  id            String   @id @default(cuid())
  institutionId String
  entity        String
  step          String
  ownerRoles    Json
  nextStep      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([institutionId, entity, step])
}

model ApprovalHistory {
  id          String         @id @default(cuid())
  entity      String
  entityId    String
  step        String
  action      ApprovalAction
  actorId     String?
  actorEmail  String?
  note        String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([entity, entityId, createdAt])
}
