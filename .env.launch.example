# Production launch parameters for SPMI accreditation module.
# Copy to /opt/spmi/.env on the production server and replace values marked CHANGE_ME.

TRAEFIK_ACME_EMAIL=CHANGE_ME_ADMIN_EMAIL
SPMI_FRONTEND_DOMAIN=spmi.CHANGE_ME_DOMAIN
SPMI_API_DOMAIN=api-spmi.CHANGE_ME_DOMAIN

POSTGRES_DB=spmi_command_center
POSTGRES_USER=spmi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1d

ENABLE_API_DOCS=false
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_MAX=120

SIAKAD_SYNC_ENABLED=false
SIAKAD_BASE_URL=
SIAKAD_AUTH_TYPE=bearer
SIAKAD_API_KEY_HEADER=X-API-Key
SIAKAD_API_TOKEN=
SIAKAD_HEALTH_PATH=
SIAKAD_ORG_UNITS_PATH=/org-units
SIAKAD_TIMEOUT_MS=10000
SIAKAD_SYNC_MODE=manual
