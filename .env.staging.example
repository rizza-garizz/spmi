# Copy to .env on a staging server for database UAT with the internal mock SIAKAD API.

TRAEFIK_ACME_EMAIL=admin@example.com
SPMI_FRONTEND_DOMAIN=staging-spmi.example.com
SPMI_API_DOMAIN=staging-api-spmi.example.com

POSTGRES_DB=spmi_command_center
POSTGRES_USER=spmi
POSTGRES_PASSWORD=change-this-staging-database-password

JWT_SECRET=change-this-to-a-long-random-staging-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

ENABLE_API_DOCS=true
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_MAX=120

# Staging mock SIAKAD: backend and UAT script run in the same container,
# so 127.0.0.1 points to the backend container itself.
SIAKAD_SYNC_ENABLED=true
SIAKAD_BASE_URL=http://127.0.0.1:4555/api
SIAKAD_AUTH_TYPE=bearer
SIAKAD_API_KEY_HEADER=X-API-Key
SIAKAD_API_TOKEN=staging-mock-token
SIAKAD_HEALTH_PATH=
SIAKAD_ORG_UNITS_PATH=/org-units
SIAKAD_TIMEOUT_MS=10000
SIAKAD_SYNC_MODE=manual
